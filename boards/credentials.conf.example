# Copy to boards/credentials.conf and fill in real values.
# This file is gitignored — never commit credentials.
#
# To apply during build:
#   west build ... -- -DEXTRA_CONF_FILE=boards/credentials.conf
#
CONFIG_TRACKER_MQTT_USERNAME="your-hivemq-username"
CONFIG_TRACKER_MQTT_PASSWORD="your-hivemq-password"
